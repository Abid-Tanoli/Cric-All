# Root .env for `docker compose` (compose reads this file automatically).
# Copy to .env and replace every placeholder. Never commit the real .env.
#
# Backend runtime values (database URL, JWT secret, mail/SMS credentials, etc.)
# live in Backend/.env, not here. See Backend/.env.example.

# Host ports published by docker compose. Container ports stay 5000/3000/3001.
# Defaults match docker-compose.yml so other environments keep their layout.
# The production VPS uses 5050/3300/3301 because the portfolio project already
# occupies 3000/3001/5000.
BACKEND_HOST_PORT=5000
USER_FRONTEND_HOST_PORT=3000
ADMIN_FRONTEND_HOST_PORT=3001

# Root credentials for the optional local mongodb service
# (`docker compose --profile local-mongo ...`). They are only required when that
# profile is used; Atlas-only deployments can leave them empty.
# On an existing data volume they are NOT re-applied: MONGO_INITDB_* only seeds
# the root user when mongo_data is first initialized. See
# docs/mongo-password-rotation.md to change an existing user's password.
MONGO_ROOT_USERNAME=replace_with_local_mongo_root_username
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
