# CricAll production example. VITE_API_URL must include the /api suffix.
#
# There is deliberately no cricket API key here. Third-party cricket keys used
# to be passed as VITE_CRICAPI_KEY, but Vite inlines every VITE_* variable into
# the browser bundle, which published the key to every visitor. External cricket
# data is now fetched through the backend (/api/international/*), which reads
# CRICKET_API_KEY / RAPIDAPI_KEY from the server environment. Configure those in
# the backend's environment instead; nothing in this file should ever hold a
# secret.
VITE_API_URL=https://your-cricall-backend-on-render.com/api
VITE_SOCKET_URL=https://your-cricall-backend-on-render.com
# Google OAuth Client ID (must match GOOGLE_CLIENT_ID in Backend/.env, and be
# threaded through as a build arg in docker-compose.yml as VITE_GOOGLE_CLIENT_ID).
# When blank or the placeholder, Google sign-in buttons are hidden.
# Create the Client ID in Google Cloud Console and authorize the live origin,
# e.g. http://187.127.96.220:3300, in "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Navigation feature flags (src/config/features.js). These are build-time
# variables: Vite inlines them, so a running container does not re-read them —
# set them in your .env BEFORE `docker compose build` and they are baked into
# the bundle by the User/Dockerfile build args (see docker-compose.yml).
#
# External-only sections (no active backend feed) are HIDDEN by default; set the
# literal string "true" to restore one:
VITE_SHOW_INTERNATIONAL=false
VITE_SHOW_HIGHLIGHTS=false
VITE_SHOW_CRICKET_NEWS=false
#
# Platform-owned sections are VISIBLE by default; set "false" to hide a section
# (e.g. while a tournament homepage is being prepared):
VITE_SHOW_VIDEOS=true
VITE_SHOW_RANKINGS=true
VITE_SHOW_COMPARISON=true
VITE_SHOW_BLOGS=true
