[Unit]
Description=CricAll automated MongoDB backup (runs backupDb.js)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Point to the repo checkout that contains the script, or run via docker exec
# against the cricall-mongo container (Docker must be available on this host).
WorkingDirectory=/opt/cricall/Backend
ExecStart=/usr/bin/node /opt/cricall/Backend/src/scripts/backupDb.js
User=root
# Exit code 3 means the local database backup SUCCEEDED but the optional
# off-site copy failed. The archive stays in Backend/backups; check journalctl,
# then keep OFFSITE_BACKUP_ENABLED=true or set it to false to silence it.
# Off-site setup: docs/vps-deploy-runbook.md section 10.