# CricAll database configuration
# Replace this placeholder with an Atlas URI that includes your existing database name.
MONGODB_URI=your_mongodb_atlas_uri_here
# Legacy alternatives are also supported: MONGO_URL and MONGO_URI.
REQUIRE_MONGO_DB_NAME=true
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=1

# Destructive scripts require explicit opt-in. Keep all three false in production.
ALLOW_DESTRUCTIVE_DB_SEED=false
ALLOW_PRODUCTION_DB_RESET=false
ALLOW_DB_RESET=false

# CricAll server configuration
# Render sets PORT automatically; keep 5000 for local development.
PORT=5000
NODE_ENV=production
# Comma-separated exact browser origins (scheme + host, no path).
# In production, set this to your deployed user/admin frontend origins.
# Localhost origins are allowed automatically only when NODE_ENV is not production.
CORS_ORIGINS=https://your-user-frontend-url,https://your-admin-frontend-url
# Optional aliases accepted in addition to CORS_ORIGINS. Leave blank unless already used by your deploy setup.
CLIENT_URL=
ADMIN_URL=
FRONTEND_URL=
# Public base URL of THIS backend, used to build absolute URLs for uploaded
# images (e.g. http://203.0.113.10:5050). When blank, the request host is
# used. Required for photo previews to work when the frontends are served
# from a different origin/port than the backend.
PUBLIC_BACKEND_URL=
LOG_LEVEL=info
LOG_REQUESTS=false
LOG_SOCKET=false

# Vercel sets this automatically. Keep 0 for a persistent Node server.
VERCEL=0

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Optional one-time `npm run admin:create` inputs. Not required at runtime.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed script credentials (REQUIRED before running `npm run seed` or `seedAll.js`).
# The seed scripts refuse to run if either SEED_ADMIN_EMAIL or SEED_ADMIN_PASSWORD
# is missing. Do not use a default/guessable value in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# RapidAPI (Cricbuzz) Configuration (Optional)
RAPIDAPI_KEY=
RAPIDAPI_CRICKET_HOST=free-cricbuzz-cricket-api.p.rapidapi.com
RAPIDAPI_LIVE_MATCHES_PATHS=/cricket-matches-live,/cricket-livescores
RAPIDAPI_UPCOMING_MATCHES_PATHS=/cricket-schedule-international,/cricket-matches-upcoming
RAPIDAPI_RECENT_MATCHES_PATHS=/cricket-matches-recent
RAPIDAPI_MATCH_INFO_PATHS=/cricket-match-info?matchid={id}
RAPIDAPI_SERIES_INTERNATIONAL_PATHS=/cricket-series-international
RAPIDAPI_SERIES_LEAGUE_PATHS=/cricket-series-leagues
RAPIDAPI_SERIES_DOMESTIC_PATHS=/cricket-series-domestic
RAPIDAPI_SERIES_MATCHES_PATHS=

# Free Cricbuzz API (Optional alternative)
ENABLE_FREE_CRICBUZZ=false
FREE_CRICBUZZ_BASE_URL=

# Legacy Cricket API Configuration (Optional)
CRICKET_API_KEY=
CRICKET_API_PROVIDER=cricapi
CRICKET_POLL_INTERVAL=180
# Never enable demo cricket data in production.
ENABLE_DEMO_CRICKET_DATA=false

# Optional RSS news feed URLs as a JSON array.
CRICKET_NEWS_FEEDS=[]

# YouTube Data API v3 (Optional)
YOUTUBE_API_KEY=

# Google OAuth (Required for Google Sign-In to appear/work at all)
# Create a Google Cloud Console OAuth 2.0 Client ID (APIs & Services > Credentials)
# and authorize the live site origins in "Authorized JavaScript origins",
# e.g. http://187.127.96.220:3300 plus the real domain once one exists.
# IMPORTANT: this value MUST match the VITE_GOOGLE_CLIENT_ID build arg passed to
# the User frontend (and Admin frontend) — both are compared against the same ID.
# When blank, the Google buttons stay hidden.
GOOGLE_CLIENT_ID=

# AI Commentary (Optional)
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# External Sync (Optional)
ENABLE_EXTERNAL_SYNC=false
# Legacy alias supported by the backend startup gate.
ENABLE_ESPN_SYNC=false
EXTERNAL_SYNC_BASE_URL=
SYNC_INTERVAL=30

# Sentry Error Tracking (Optional)
SENTRY_DSN=
# The custom transport is disabled by default. Prefer the official Sentry SDK.
ENABLE_CUSTOM_SENTRY=false
