# CricAll database configuration
# Replace this placeholder with an Atlas URI that includes your existing database name.
MONGODB_URI=your_mongodb_atlas_uri_here
# Legacy alternatives are also supported: MONGO_URL and MONGO_URI.
REQUIRE_MONGO_DB_NAME=true
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=1

# Destructive scripts require explicit opt-in. Keep all three false in production.
ALLOW_DESTRUCTIVE_DB_SEED=false
ALLOW_PRODUCTION_DB_RESET=false
ALLOW_DB_RESET=false

# CricAll server configuration
# Render sets PORT automatically; keep 5000 for local development.
PORT=5000
NODE_ENV=production
# Comma-separated exact browser origins (scheme + host, no path).
# In production, set this to your deployed user/admin frontend origins.
# Localhost origins are allowed automatically only when NODE_ENV is not production.
CORS_ORIGINS=https://your-user-frontend-url,https://your-admin-frontend-url
# Optional aliases accepted in addition to CORS_ORIGINS. Leave blank unless already used by your deploy setup.
CLIENT_URL=
ADMIN_URL=
FRONTEND_URL=
# Public base URL of THIS backend, used to build absolute URLs for uploaded
# images (e.g. http://203.0.113.10:5050). When blank, the request host is
# used. Required for photo previews to work when the frontends are served
# from a different origin/port than the backend.
PUBLIC_BACKEND_URL=
LOG_LEVEL=info
LOG_REQUESTS=false
LOG_SOCKET=false

# Vercel sets this automatically. Keep 0 for a persistent Node server.
VERCEL=0

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Email delivery (verification codes, password reset, invitations, issue notices).
# MAIL_DRIVER=console (default) writes messages, including the raw 6-digit code,
# to the SERVER LOG ONLY. This is the only place a code is ever logged; use it
# for local testing. Set MAIL_DRIVER=smtp only after filling in all required
# MAIL_* values; if any is missing the backend warns (variable names only) and
# uses console. Never log mail bodies from application code.
# When running via docker compose these values come from the ROOT .env instead.
# Replace placeholders only; never commit real credentials.
MAIL_DRIVER=console
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
# Max issue-report notification emails per recipient per rolling hour.
MAIL_ISSUE_NOTIFY_MAX_PER_HOUR=10
# Optional recipient for organization issue/deletion-request notifications.
ADMIN_NOTIFICATION_EMAIL=
# Brevo: MAIL_HOST=smtp-relay.brevo.com, port 587, MAIL_PASS=SMTP key.
# Gmail: MAIL_HOST=smtp.gmail.com, port 587, MAIL_PASS=App Password (2FA).
# Custom From domains need SPF + DKIM DNS records for reliable delivery.
# Email verification code policy (6-digit numeric code, hashed at rest).
# EMAIL_CODE_MINUTES: code lifetime, default 10. Codes are single-use; five
# wrong attempts invalidate the code and require a resend.
# EMAIL_VERIFICATION_MAX_PER_HOUR: rolling-hour send cap PER USER and PER IP
# (shared in-memory limiter), default 10. Resend has a separate 60s cooldown.
# EMAIL_MX_CHECK: set to "false" only in local tests to skip DNS MX validation;
# DNS failures/timeouts always fail open in production and never block signup.
# EMAIL_MX_TIMEOUT_MS: MX lookup timeout, default 2500.
EMAIL_CODE_MINUTES=10
EMAIL_VERIFICATION_MAX_PER_HOUR=10
EMAIL_MX_CHECK=true
EMAIL_MX_TIMEOUT_MS=2000

# Phone signup remains allowed, but SMS/phone verification is DEFERRED:
# no SMS is sent, /auth/verify-phone and /auth/resend-phone-otp return 400,
# phone is always shown as "not verified", and a phone number can never satisfy
# the identity gate. Phone-only accounts must add/verify an email to create
# organizations, teams, players, tournaments or community posts.
DEFAULT_PHONE_COUNTRY_CODE=92
PHONE_OTP_MINUTES=10
SMS_DRIVER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Temporary verification kill switch. When REQUIRE_VERIFIED_ACCOUNT is the exact
# string "false", an authenticated account may create organizations/teams/
# matches/players and accept invitations WITHOUT a verified EMAIL.
# Admin-role, tenant and session checks are unaffected. Default (absent / any
# other value, including "0"/"no") keeps the requirement ON. Phone verification
# is not part of this gate anymore.
#
# OWNER ACTION: keep this true in production. While it is off, anyone who can
# sign up can act without proving control of an email address.
REQUIRE_VERIFIED_ACCOUNT=true

# Optional one-time `npm run admin:create` inputs. Not required at runtime.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public first-admin bootstrap switch for POST /api/admin/register. Leave false
# in production: when it is on, the first person to reach the endpoint on an
# empty Admin collection becomes superadmin. Absent, empty, "false", "0" and
# "no" all mean OFF, so a typo fails closed. This only matters while the Admin
# collection is empty - once one admin exists the endpoint stays closed
# regardless - so the safe procedure is `npm run admin:create` (above) instead of
# turning this on. See docs/first-admin-bootstrap.md.
ALLOW_ADMIN_REGISTER=false

# Seed script credentials (REQUIRED before running `npm run seed` or `seedAll.js`).
# The seed scripts refuse to run if either SEED_ADMIN_EMAIL or SEED_ADMIN_PASSWORD
# is missing. Do not use a default/guessable value in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# RapidAPI (Cricbuzz) Configuration (Optional)
RAPIDAPI_KEY=
RAPIDAPI_CRICKET_HOST=free-cricbuzz-cricket-api.p.rapidapi.com
RAPIDAPI_LIVE_MATCHES_PATHS=/cricket-matches-live,/cricket-livescores
RAPIDAPI_UPCOMING_MATCHES_PATHS=/cricket-schedule-international,/cricket-matches-upcoming
RAPIDAPI_RECENT_MATCHES_PATHS=/cricket-matches-recent
RAPIDAPI_MATCH_INFO_PATHS=/cricket-match-info?matchid={id}
RAPIDAPI_SERIES_INTERNATIONAL_PATHS=/cricket-series-international
RAPIDAPI_SERIES_LEAGUE_PATHS=/cricket-series-leagues
RAPIDAPI_SERIES_DOMESTIC_PATHS=/cricket-series-domestic
RAPIDAPI_SERIES_MATCHES_PATHS=

# Free Cricbuzz API (Optional alternative)
ENABLE_FREE_CRICBUZZ=false
FREE_CRICBUZZ_BASE_URL=

# Legacy Cricket API Configuration (Optional)
CRICKET_API_KEY=
CRICKET_API_PROVIDER=cricapi
CRICKET_POLL_INTERVAL=180
# Never enable demo cricket data in production.
ENABLE_DEMO_CRICKET_DATA=false

# Optional RSS news feed URLs as a JSON array.
CRICKET_NEWS_FEEDS=[]

# YouTube Data API v3 (Optional)
YOUTUBE_API_KEY=

# Google OAuth (Required for Google Sign-In to appear/work at all)
# Create a Google Cloud Console OAuth 2.0 Client ID (APIs & Services > Credentials)
# and authorize the live site origins in "Authorized JavaScript origins",
# e.g. http://187.127.96.220:3300 plus the real domain once one exists.
# IMPORTANT: this value MUST match the VITE_GOOGLE_CLIENT_ID build arg passed to
# the User frontend (and Admin frontend) — both are compared against the same ID.
# When blank, the Google buttons stay hidden.
GOOGLE_CLIENT_ID=

# AI Commentary (Optional)
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Organization Approval (Optional)
# Seeds the platform settings on first boot. Administrators can change both of
# these later in the Admin app, which writes to the database and wins from then
# on. Both default to false so organizations self-serve.
REQUIRE_ORG_APPROVAL=false
REQUIRE_MEMBER_APPROVAL=false

# External Sync (Optional)
ENABLE_EXTERNAL_SYNC=false
# Legacy alias supported by the backend startup gate.
ENABLE_ESPN_SYNC=false
EXTERNAL_SYNC_BASE_URL=
SYNC_INTERVAL=30

# Off-site encrypted backups (Optional; OFF by default)
#
# The nightly backup (src/scripts/backupDb.js) and the weekly uploads archive
# (src/scripts/backupUploads.js) can upload an AES-256-GCM encrypted copy to an
# rclone remote, so a dead VPS does not take the backups with it. Nothing is
# uploaded until OFFSITE_BACKUP_ENABLED=true. Setup steps and the restore
# procedure: docs/vps-deploy-runbook.md section 10. Never commit real values.
#
# rclone destination, e.g. cricall-offsite:cricall-backups
# (the remote is configured once with `rclone config`)
OFFSITE_BACKUP_ENABLED=false
OFFSITE_REMOTE=
# Absolute path to a mode-600 file holding ONLY the encryption passphrase.
# Generate it on the server; never paste it into an .env value, chat or git.
OFFSITE_PASSPHRASE_FILE=/root/.config/cricall/offsite-passphrase
# Delete remote objects older than this many days (0 = never delete remotely).
OFFSITE_RETENTION_DAYS=30
# Skip the weekly uploads upload when the tar.gz is larger than this (0 = no limit).
OFFSITE_UPLOADS_MAX_MB=2048

# Sentry Error Tracking (Optional)
SENTRY_DSN=
# The custom transport is disabled by default. Prefer the official Sentry SDK.
ENABLE_CUSTOM_SENTRY=false
