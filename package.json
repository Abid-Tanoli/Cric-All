{
  "name": "cricall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm --prefix Backend test && npm --prefix Frontend/Admin test && npm --prefix Frontend/User test",
    "test:backend": "npm --prefix Backend test",
    "stats:recompute": "npm --prefix Backend run stats:recompute --",
    "orgs:backfill-slugs": "npm --prefix Backend run orgs:backfill-slugs --",
    "test:admin": "npm --prefix Frontend/Admin test",
    "test:user": "npm --prefix Frontend/User test",
    "test:brand": "node --test Frontend/Shared/branding/test/brand.test.mjs",
    "test:smoke": "node Backend/scripts/api-smoke-test.cjs",
    "test:scoring": "node Backend/scripts/scoring-flow-test.cjs",
    "build": "npm --prefix Backend install && npm --prefix Frontend/User install && npm --prefix Frontend/Admin install && npm --prefix Frontend/User run build && npm --prefix Frontend/Admin run build",
    "build:user": "npm --prefix Frontend/User run build",
    "build:admin": "npm --prefix Frontend/Admin run build",
    "build:backend": "npm --prefix Backend install",
    "start": "npm --prefix Backend start",
    "dev:backend": "npm --prefix Backend run dev",
    "dev:user": "npm --prefix Frontend/User run dev",
    "dev:admin": "npm --prefix Frontend/Admin run dev",
    "docker:build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-build-backend.ps1",
    "docker:build:user": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-build-user.ps1",
    "docker:build:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-build-admin.ps1",
    "docker:push:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-push-all.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.16",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.12.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.18",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.4"
  }
}
